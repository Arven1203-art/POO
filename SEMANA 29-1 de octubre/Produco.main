package producto;
public class Producto {  
    public static void main(String[] args) {
        Main producto1 = new Main ();
        producto1.setNombre("portatil");
        producto1.setCategoria("Electronico");
        producto1.setPrecio(3000000);
        producto1.setCantidadstock(500);
        System.out.println(producto1.verDetalle());
        System.out.println(producto1.calcularDescuento(10));
        System.out.println(producto1.calcularDescuento(10f));
        System.out.println(producto1.calcularPrecioFinal(10));
        System.out.println(producto1.vender(200));
        
    }
}
