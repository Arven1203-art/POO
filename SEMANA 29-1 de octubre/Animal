package herencia30sept;
public class Animal {
    private String especie;

    public Animal() {
    }

    public String getEspecie() {
        return especie;
    }

    public void setEspecie(String especie) {
        this.especie = especie;
    }
    public void comer(){
        System.out.println("El animal de especie: " + this.especie + " come todos los dias.");   
    }
    public void dormir(){
        System.out.println("El animal de especie: " + this.especie + " duerme todos los dias");
    }
  
}
